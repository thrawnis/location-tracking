# Copy this file to .env and fill in the values before running docker compose.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to True only during development
DEBUG=False

# Comma-separated hostnames/IPs that Django will serve
ALLOWED_HOSTS=*

# PostgreSQL credentials
POSTGRES_DB=locationtracker
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-strong-password

# Google Maps JavaScript API key — required for the interactive map.
# Create one at https://console.cloud.google.com/ and enable the following APIs:
#   Maps JavaScript API, Places API, Geocoding API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ── Admin "Maps usage" page (OPTIONAL) ────────────────────────────────────────
# Pulls real API call counts (Cloud Monitoring) and cost (BigQuery billing
# export). Leave blank to skip — the admin page then shows setup instructions.
# See docs/google-maps-costs.md for the full setup (service account, roles,
# enabling the Monitoring API, and setting up billing export to BigQuery).
GCP_PROJECT_ID=
# Path INSIDE the container to a mounted service-account JSON key (read-only).
# Mount it via docker-compose, e.g. ./data/gcp-credentials.json:/app/data/gcp-credentials.json:ro
GCP_CREDENTIALS_FILE=
# BigQuery billing-export table, e.g.
#   my-project.billing_export.gcp_billing_export_v1_0123AB_4567CD_89EF01
GCP_BILLING_BQ_TABLE=
